{
  "name": "caderno-compras",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "node --env-file=.env.test --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:shell": "docker compose exec db mysql -ucaderno -pcaderno caderno",
    "migrate": "node --env-file-if-exists=.env src/cli/migrate.ts",
    "hash-password": "node src/cli/hashPassword.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/formbody": "^9.0.2",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@fastify/view": "^12.0.1",
    "@types/node": "^24.19.2",
    "drizzle-orm": "^0.45.4",
    "es-toolkit": "^1.53.2",
    "eta": "^4.6.0",
    "fastify": "^5.12.8",
    "htmx.org": "^2.0.11",
    "mysql2": "^3.24.6",
    "typescript": "~6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
