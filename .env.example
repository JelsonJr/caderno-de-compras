# Copie para .env (cp .env.example .env) e preencha.
# Em produção (Hostinger), cadastre estas variáveis no hPanel, não use arquivo .env.

# development | production. Em produção: cookie só via HTTPS (__Host-session) e logs em nível info.
NODE_ENV=development

# Endereço e porta locais. Na Hostinger são ignorados (o LiteSpeed usa o socket dele): não cadastre.
HOST=0.0.0.0
PORT=3000

# Opcional: fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=debug

# Proxies em que se pode acreditar no X-Forwarded-For (IP real do visitante), separados por vírgula:
# unix (socket Unix do LiteSpeed), loopback, linklocal, uniquelocal, IPs ou faixas CIDR.
# Vazio = nenhum (desenvolvimento local). Na Hostinger: veja o README.
TRUST_PROXY=

# Banco: os valores abaixo são os do docker-compose.yml (npm run db:up)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=caderno
DB_PASSWORD=caderno
DB_NAME=caderno

# Assina o cookie de sessão. Mínimo de 32 caracteres. Gere um novo para cada ambiente com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Hash da senha de acesso. Gere com: npm run hash-password
ADMIN_PASSWORD_HASH=
