<% layout('/layout', { title: 'Itens', loggedIn: true }) %>
<div class="page-head">
  <h1>Itens</h1>
  <a class="button primary" href="/items/new"><%~ include('/partials/icon', { name: 'plus' }) %>Novo item</a>
</div>

<form method="get" action="/" class="filter" hx-get="/" hx-trigger="change" hx-target="#item-list" hx-swap="outerHTML" hx-push-url="true">
  <label for="status-filter">Status</label>
  <select id="status-filter" name="status">
    <option value="">Todos</option>
    <% for (const status of it.ITEM_STATUSES) { %>
    <option value="<%= status %>"<% if (it.status === status) { %> selected<% } %>><%= it.ITEM_STATUS_LABELS[status] %></option>
    <% } %>
  </select>
  <noscript><button type="submit" class="button">Filtrar</button></noscript>
</form>

<%~ include('/items/_list', it) %>
